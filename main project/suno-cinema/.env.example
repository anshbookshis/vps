# ==============================================================================
# Suno Cinema - Environment Configuration
# ==============================================================================

# HTTP Port for Node Server
PORT=3000

# The Movie Database (TMDB) API Key (v3 32-char key or v4 Bearer Read Access Token)
# Get a free key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Secret key used to sign and verify playback HMAC-SHA256 play tokens (/api/play and /api/proxy/hls)
SUNO_PLAY_SECRET=suno-cinema-secret-token-key-2026

# Set to true to strictly require a valid signed token on all /api/proxy/hls requests
REQUIRE_PLAY_TOKEN=false

# Comma-separated list of bootstrap and fallback mirror origins for high-availability discovery
SUNO_BOOTSTRAP_MIRRORS=https://suno-cinema-mirror1.example.com,https://suno-cinema-mirror2.example.com

# Authorized VOD origin (S3 / R2 / Backblaze B2 / CDN endpoint)
SUNO_VOD_ORIGIN=

# Debrid API Keys for instant cached stream playback
REALDEBRID_API_KEY=
TORBOX_API_KEY=

# Stremio Addon URLs (comma-separated or JSON array)
STREMIO_ADDON_URLS=https://v3-cinemeta.strem.io/manifest.json,https://torrentio.strem.fun/manifest.json

# Jellyfin / Emby Server Configuration
JELLYFIN_URL=
JELLYFIN_API_KEY=

# Custom Resolver URL Template (optional)
# Variables: {imdbId}, {tmdbId}, {mediaType}, {season}, {episode}
CUSTOM_RESOLVER_URL=
